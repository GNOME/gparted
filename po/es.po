msgstr "No se pudo desactivar el espacio de intercambio"

#: src/Win_GParted.cc:3020
msgid ""
"The swapon action cannot be performed when there are operations pending for "
"the partition."
msgstr ""
"No se puede realizar la acción de activar el intercambio cuando existe una "
"operación pendiente para la partición."

#: src/Win_GParted.cc:3021
msgid "Activating swap on %1"
msgstr "Activando el espacio de intercambio en %1"

#: src/Win_GParted.cc:3022
msgid "Could not activate swap"
msgstr "No se pudo sactivar el espacio de intercambio"

#: src/Win_GParted.cc:3027
msgid ""
"The deactivate Volume Group action cannot be performed when there are "
"operations pending for the partition."
msgstr ""
"No se puede realizar la acción de desactivar el grupo de volúmenes cuando "
"hay una operación pendiente para la partición."

#: src/Win_GParted.cc:3028
